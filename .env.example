# ==========================================
# Shuttle Tracking System - Environment Variables
# ==========================================

# Database (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_DB=shuttle_tracking
POSTGRES_USER=shuttle
POSTGRES_PASSWORD=shuttle_secret_dev
DATABASE_URL=postgres://shuttle:shuttle_secret_dev@postgres:5432/shuttle_tracking

# MQTT Broker (Eclipse Mosquitto 2.0)
MQTT_BROKER_URL=mqtt://mosquitto:1883

# Backend API
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
JWT_SECRET=shuttle_jwt_super_secret_key_2026
JWT_EXPIRES_IN=24h

# Frontend Next.js (Optional: auto-detects VM hostname in browser if omitted)
# NEXT_PUBLIC_API_URL=http://<YOUR_VM_IP>:3000/api/v1
# NEXT_PUBLIC_WS_URL=ws://<YOUR_VM_IP>:3000
