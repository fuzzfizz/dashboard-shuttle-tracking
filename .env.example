# ===================================================================
# Shuttle Tracker - All-in-One Deployment Environment Variables
# ===================================================================
# These 3 variables are the ONLY required settings for running on Render.
# Copy values from: Supabase Console -> Project Settings -> API
# ===================================================================

# 1. Supabase Project URL (Used by both backend worker and frontend web app)
SUPABASE_URL=https://<your-project-id>.supabase.co

# 2. Supabase Service Role Secret Key (Required for backend worker to record daily distance with RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Supabase Anon Public Key (Required for frontend dashboard to read and display daily distance)
# Note: You can name this either VITE_SUPABASE_ANON_KEY or SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
