MQTT_BROKER=mqtt://your_mqtt_broker_host:1883
MQTT_TOPIC=shuttle/+
VITE_MQTT_USERNAME=your_faculty_username
VITE_MQTT_PASSWORD=your_faculty_password

# Supabase REST Credentials
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_ANON_KEY=<your-anon-key>

# Supabase Direct / Pooler Database Connection (for running migrations)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=<your-db-password>
DB_NAME=postgres
