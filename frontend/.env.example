# MQTT Broker URL (Must be WebSocket - ws:// for localhost or wss:// for production/Vercel)
VITE_MQTT_BROKER_URL=wss://65f2ec1d516f46368f91e15a90eb91a1.s1.eu.hivemq.cloud:8884/mqtt

# MQTT Topic Subscription (supports MQTT wildcards like + and #)
VITE_MQTT_TOPIC=shuttle/+

# Authentication
VITE_MQTT_USERNAME=cmu_phamacy_shuttle
VITE_MQTT_PASSWORD=cmu_phamacy_shuttle

# Optional: CARTO Basemaps API Key (if you want Carto Positron instead of OpenStreetMap)
# Get a free key at: https://carto.com/basemaps/apikey
# VITE_CARTO_API_KEY=your_carto_api_key

# Supabase Credentials (Daily distance aggregation and logs)
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
