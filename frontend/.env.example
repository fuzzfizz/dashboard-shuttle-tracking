# MQTT Broker URL (Must be WebSocket - ws:// for localhost or wss:// for production/Vercel)
VITE_MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt

# MQTT Topic Subscription (supports MQTT wildcards like + and #)
VITE_MQTT_TOPIC=shuttle/fleet/v1/+/telemetry

# Optional authentication for private brokers
# VITE_MQTT_USERNAME=my_username
# VITE_MQTT_PASSWORD=my_password

# Optional: CARTO Basemaps API Key (if you want Carto Positron instead of OpenStreetMap)
# Get a free key at: https://carto.com/basemaps/apikey
# VITE_CARTO_API_KEY=your_carto_api_key

